  "source": {
    "entry_point": "agent_bridge.cli:main",
    "package_version": "0.1.0",
    "project": "agent-bridge",
    "python_requires": ">=3.11"
  },
  "storage": {
    "database": {
      "per_project": true,
      "relative_path": "state.sqlite"
    },
    "indexes": [
      {
        "definition": "UNIQUE tasks(project_id) WHERE status IN ('implementing','awaiting_review','revising','needs_user','failed','delivery_unknown')",
        "name": "ux_tasks_active",
        "purpose": "at most one unfinished task per project"
      },
      {
        "definition": "UNIQUE rounds(project_id, request_id)",
        "name": "ux_rounds_request",
        "purpose": "request idempotency"
      },
      {
        "definition": "events(task_id, id)",
        "name": "ix_events_task",
        "purpose": "ordered event lookup per task"
      }
    ],
    "invariants": [
      "PRAGMA user_version is only changed by a migration; unsupported versions are refused",
      "at most one unfinished task per project (ux_tasks_active partial unique index)",
      "each round references an existing task (foreign key rounds.task_id -> tasks.task_id)",
      "round completion and task status update are atomic in one transaction (finish_round)",
      "rounds(project_id, request_id) is unique for request idempotency",
      "task.allowed_paths and task.test_commands are JSON text arrays; task.snapshot, round.result_json and round.verifier_json are JSON text",
      "tasks.session_id points at the current round's session and is NULL between revision-round creation and session resolution",
      "verifier_state is 'running' or 'done'; a 'done' result is never overwritten and is reused by recovery"
    ],
    "migratable_versions": [
      0,
      1,
      2,
      3,
      4,
      5
    ],
    "pragmas": {
      "connect": [
        "PRAGMA journal_mode=WAL",
        "PRAGMA foreign_keys=ON",
        "PRAGMA busy_timeout=30000"
      ],
      "transaction": [
        "PRAGMA journal_mode=WAL",
        "PRAGMA foreign_keys=ON",
        "PRAGMA busy_timeout=30000",
        "BEGIN IMMEDIATE"
      ]
    },
