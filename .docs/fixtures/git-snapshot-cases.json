  "corpus_version": 1,
  "error_categories": {
    "git_snapshot_failed": "A git command used while snapshotting a valid worktree raised GitError (for example a timeout or a failing git subcommand). Only the category is contract; the detail text is not.",
    "not_a_git_repo": "The workspace is not a Git worktree (git_snapshot.is_repo is false) so no snapshot can be taken. Comparison-level counterpart: worker._repo_changes returns git_policy_violations=['not_a_git_repo'] with empty change lists and head_after=null."
  },
  "fingerprint_relations": {
    "changed": "The after fingerprint differs from the before fingerprint.",
    "equal": "The after fingerprint equals the before fingerprint."
  },
  "git_policy_violation_categories": {
    "head_changed": "current_head != base_head while commit permission is not granted (allow_commit is not True).",
    "history_rewritten": "base_head is no longer an ancestor of current_head (git merge-base --is-ancestor is false); reported regardless of commit permission.",
    "index_changed": "index_fingerprint differs from the before index fingerprint while commit permission is not granted.",
    "not_a_git_repo": "Comparison-level missing_code returned by worker._repo_changes when the repository directory is missing or is not a Git repository."
  },
  "mutation_dsl": {
    "chmod_exec": "{op:'chmod_exec', path, mode?}: set the executable bit on a file (default 0755). Content is unchanged; only the tracked mode bit differs.",
    "delete_file": "{op:'delete_file', path}: remove a file from the worktree.",
    "git_add": "{op:'git_add', path}: stage the current content of path in the index.",
    "git_add_intent": "{op:'git_add_intent', path}: git add -N (intent-to-add); changes index flags without staging content.",
    "git_amend": "{op:'git_amend', message, add?}: stage add then git commit --amend; rewrites history.",
    "git_commit": "{op:'git_commit', message, add?}: stage add (when present) then create a new commit.",
    "symlink_create": "{op:'symlink_create', path, target}: create a symlink.",
    "symlink_retarget": "{op:'symlink_retarget', path, target}: replace an existing symlink so it points at target.",
    "write_file": "{op:'write_file', path, content}: write content to path, creating parent directories; replaces the file if it exists."
  },
  "operations": {
    "snapshot_compare": "Take before = git_snapshot.take_snapshot(workspace), apply mutations in order, then compute exactly what worker._repo_changes computes for one repository: changed_paths = git_snapshot.changed_paths(workspace, before.manifest); committed_paths = git_snapshot.committed_paths(workspace, before.head); scope_violations = git_snapshot.scope_violations(sorted(set(changed_paths) | set(committed_paths)), allowed_paths); git_policy_violations from history_descends_from plus (when allow_commit is not True) head/index fingerprint comparisons. All path lists are repository-relative and sorted.",
    "snapshot_error": "A submit-time snapshot failure path. The harness simulates the declared stage ('repo_check' for is_repo, 'snapshot' for a GitError during take_snapshot) and compares only the stable error category. Detail strings are not contract."
  },
  "placeholder_conventions": {
    "${HEAD_BEFORE}": "Commit hash of the before snapshot; an opaque placeholder, never a real hash.",
    "${INDEX_FP_BEFORE}": "Index fingerprint of the before snapshot: sha256 over git ls-files --stage and git ls-files -v.",
    "${WORKSPACE}": "Absolute path of the single synthetic Git repository root; one repository per case.",
    "${WORKTREE_FP_BEFORE}": "Worktree fingerprint of the before snapshot: the git_snapshot.manifest mapping of tracked and non-ignored untracked paths to their content/mode/link-target hashes. The verifier derives a compact digest over the same manifest plus status."
  },
  "setup_dsl": {
    "commits": "Ordered list of {message, add}. Each entry stages exactly the listed workspace-relative paths and commits. Paths created by files/symlinks/gitignore but never listed stay untracked (or ignored).",
    "fault": "snapshot_error only: {snapshot_command: 'fail'} declares that the harness must make a git command used by the snapshot raise GitError, without changing any real repository.",
    "files": "List of {path, content} created before the first commit. Paths are absolute placeholder expressions rooted at ${WORKSPACE}.",
    "gitignore": "List of .gitignore patterns; the generated .gitignore is added by listing '.gitignore' in a commit add list.",
    "symlinks": "List of {path, target} created before the first commit; target is a relative link string unless it is itself a placeholder expression.",
    "workspace": "Object {git_repo}. git_repo=true initializes ${WORKSPACE} as a Git worktree with the declared commits; git_repo=false leaves it a plain directory."
  },
