  "contexts": {
    "permission": "worker bash auto-approve: worker._permission_decision with permission='bash', patterns=[command] and bash listed in auto_approve_permissions.",
    "test_command": "verifier validation: verifier.validate_test_commands([command]); allow means the returned problem list is empty."
  },
  "corpus_version": 1,
  "decision_model": {
    "allow": "permission returns reason 'configured'; test_command returns an empty problem list (reason_category is null).",
    "permission": "Fail closed unless the permission is configured and every bash pattern passes command_policy.bash_pattern_problem; the first failing pattern yields its policy reason.",
    "test_command": "Fail closed unless command_policy.bash_pattern_problem returns None and leading_assignments leaves a non-empty argv; otherwise the reason is the policy reason or missing_executable."
  },
  "reason_categories": {
    "configured": "permission-only allow reason: the configured bash permission and its patterns passed the policy.",
    "empty_bash_pattern": "pattern is empty or whitespace-only.",
    "git_write_blocked": "the resolved git subcommand is add, commit or push.",
    "missing_executable": "test_command-only deny reason: the command is only leading VAR=value assignments with no executable.",
