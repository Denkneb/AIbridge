    "${TRUSTED_DIR}": "Absolute path of a trusted external root directory that contains ${TRUSTED_REPO}, ${TRUSTED_REPO_OTHER} and ${TRUSTED_PLAIN}.",
    "${TRUSTED_ESCAPE_LINK}": "Symlink inside ${TRUSTED_DIR} whose canonical target is ${OUTSIDE_REPO}.",
    "${TRUSTED_PLAIN}": "Absolute path of a directory under ${TRUSTED_DIR} that is not inside any Git repository.",
    "${TRUSTED_REPO_OTHER}": "Absolute path of a second Git repository under ${TRUSTED_DIR}, distinct from ${TRUSTED_REPO}.",
    "${TRUSTED_REPO}": "Absolute path of a Git repository directly under ${TRUSTED_DIR}.",
    "${TRUSTED_SUBDIR}": "Absolute path of a trusted root directory nested inside ${PARENT_REPO} but not itself a repository root.",
    "${WORKSPACE_ESCAPE_LINK}": "Symlink ${WORKSPACE}/escape whose canonical target is ${OUTSIDE_DIR}.",
